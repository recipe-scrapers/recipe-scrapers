{
  "name": "recipe-scrapers",
  "version": "1.12.1",
  "description": "A TypeScript library for scraping recipe data from various cooking websites",
  "keywords": [
    "cooking",
    "food",
    "parser",
    "recipe",
    "scraper"
  ],
  "homepage": "https://github.com/recipe-scrapers/recipe-scrapers#readme",
  "bugs": {
    "url": "https://github.com/recipe-scrapers/recipe-scrapers/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Justin Williams",
    "url": "https://github.com/nerdstep"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recipe-scrapers/recipe-scrapers.git"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test --parallel --dots --bail",
    "test:coverage": "bun run test --coverage",
    "fetch-test-data": "bun scripts/fetch-test-data.ts",
    "process-test-data": "bun scripts/process-test-data.ts",
    "lint": "oxlint --deny-warnings && bun run fmt:check && bun run ts:check",
    "lint:fix": "oxlint --fix && oxfmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@standard-schema/utils": "^0.3.0",
    "iso8601-duration": "^2.1.4",
    "parse-ingredient": "^2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "cheerio": "^1.2.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "schema-dts": "^2.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "cheerio": "^1",
    "zod": "^4.5.0"
  },
  "packageManager": "bun@1.4.2"
}
