  "instructions": [
    {
      "name": null,
      "items": [
        {
          "value": "Preheat oven to 200°C (180°C fan) mark 6. In a small bowl mix together the garlic granules, cumin, coriander, paprika, chilli powder and oregano."
        },
        {
          "value": "Add the halloumi, red onion and peppers to a large baking tray. Toss with the vegetable oil and the spice mix. Cook for 20min or until the halloumi is evenly browned."
        },
        {
          "value": "Serve with tortillas, sour cream and guacamole."
        }
      ]
    }
