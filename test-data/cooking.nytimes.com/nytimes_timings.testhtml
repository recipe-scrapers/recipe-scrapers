es.com/10940941449492-The-New-York-Times-Company-Privacy-Policy">Privacy Policy</a></li><li class="pantry--ui-xs"><a class="link_link__7WCQy link_default__lKxiG legallinkssection_legalInfo__M4LRz" href="https://nytimes.com/cookie-policy">Cookie Policy</a></li></ul></section></div></div></div></footer></div></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"abraAdVariant":"","scoopRecipe":{"uri":"urn:nyt:ScoopRecipe:ad130c56911d57d3b3dda7e1d82d6e3c","url":"//cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies","title":"Brown Butter Chocolate Chip Cookies ","externalId":1024108,"rightsCategory":"NCF","seo":{"seoHeadline":null,"seoDescription":null,"__typename":"ScoopRecipeSeo"},"headerMedia":[],"__typename":"ScoopRecipe","tags":[{"semaphoreGuid":"34bd60a7-5b72-4ee1-b455-45b729e6e9b7","name":"Bake","__typename":"ScoopCookingTag","internal":false,"normalizedName":"bake","type":"PREPARATION_METHOD"},{"semaphoreGuid":"96bb6fd9-e2de-416b-bd75-48e42d87fb5e","name":"Brown Butter","__typename":"ScoopCookingTag","internal":false,"normalizedName":"brown butter","type":"INGREDIENT"},{"semaphoreGuid":"5d5ea8ee-a322-4aa8-84eb-cd99d50e31f5","name":"Chocolate Chip Cookie","__typename":"ScoopCookingTag","internal":false,"normalizedName":"chocolate chip cookie","type":"DISH"},{"semaphoreGuid":"ed94cfe1-5ebb-4e44-8b80-e93fa3d1ccb6","name":"Dessert","__typename":"ScoopCookingTag","internal":false,"normalizedName":"dessert","type":"COURSE"},{"semaphoreGuid":"b481c47b-8765-4dda-bbe7-352c7265540d","name":"Egg Yolk","__typename":"ScoopCookingTag","internal":false,"normalizedName":"egg yolk","type":"INGREDIENT"},{"semaphoreGuid":"7e77e281-48c8-4dbe-89fd-8385a32d94a9","name":"Semisweet Chocolate","__typename":"ScoopCookingTag","internal":false,"normalizedName":"semisweet chocolate","type":"INGREDIENT"},{"semaphoreGuid":"a0163d5b-5b38-4980-a65f-4078fd59f6f1","name":"Semisweet Chocolate Chip","__typename":"ScoopCookingTag","internal":false,"normalizedName":"semisweet chocolate chip","type":"INGREDIENT"},{"semaphoreGuid":"9bc171d5-f56b-4b63-ac76-fc70b1959a53","name":"Baking","__typename":"ScoopCookingTag","internal":true,"normalizedName":"baking","type":"PREPARATION_METHOD"}],"headlinerHook":{"doc":{"type":"scoop_recipe_text_body"},"__typename":"ScoopRecipeTextBodyDoc"},"headnote":{"doc":{"content":[{"content":[{"text":"There is nothing more magical than a gooey-centered, crispy-edged chocolate chip cookie. What makes this particular recipe especially enchanting is the inclusion of brown butter. It mixes right into the dry ingredients, infusing the batter with its nutty flavor without the need for a mixer or any other special equipment. An optional dash of cinnamon has a warmth that feels like a hug, and the brown sugar gives you that chew with a slight molasses taste. Whether for a holiday or an afternoon snack, these cookies may become your go-to.","type":"text"}],"type":"paragraph"}],"type":"scoop_recipe_text_body"},"__typename":"ScoopRecipeTextBodyDoc"},"time":{"readyIn":null,"totalTime":null,"__typename":"ScoopRecipeTime","displayTime":null,"prepTime":null,"cookTime":null,"timeBreakdown":null},"media":{"heroImage":{"ogCrops":[{"renditions":[{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-facebookJumbo-v2.jpg","__typename":"ImageRendition"}],"__typename":"ImageCrop"}],"__typename":"Image","crops":[{"renditions":[{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-thumbStandard-v2.jpg","width":75,"__typename":"ImageRendition"},{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-blogSmallThumb-v2.jpg","width":50,"__typename":"ImageRendition"},{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-thumbLarge-v2.jpg","width":150,"__typename":"ImageRendition"},{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-smallSquare168-v2.jpg","width":168,"__typename":"ImageRendition"},{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-smallSquare252-v2.jpg","width":252,"__typename":"ImageRendition"}],"__typename":"ImageCrop"},{"renditions":[{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-square320-v2.jpg","width":320,"__typename":"ImageRendition"},{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-moth-v2.jpg","width":151,"__typename":"ImageRendition"},{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-filmstrip-v2.jpg","width":190,"__typename":"ImageRendition"},{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-square640-v2.jpg","width":640,"__typename":"ImageRendition"},{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-mediumSquare149-v2.jpg","width":149,"__typename":"ImageRendition"},{"url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-mediumSquareAt3X-v2.jpg","width":1800,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}],"uri":"nyt://image/c0180dcc-fcaf-52c1-8d95-6a1dde63bd6e","sourceId":"100000008853980","credit":"Bobbi Lin for The New York Times. Food Stylist: Maggie Ruggiero.","altText":"Brown butter chocolate chip cookies are shown on a wire rack.","headerMediaCrops":[{"renditions":[{"width":480,"height":320,"__typename":"ImageRendition","name":"blog480","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-blog480.jpg"},{"width":1024,"height":683,"__typename":"ImageRendition","name":"jumbo","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-jumbo.jpg"},{"width":2048,"height":1366,"__typename":"ImageRendition","name":"superJumbo","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-superJumbo.jpg"},{"width":768,"height":512,"__typename":"ImageRendition","name":"master768","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-master768.jpg"}],"bleed":null,"__typename":"ImageCrop"}],"headerMediaHeroCrops":[{"renditions":[{"width":1024,"height":683,"__typename":"ImageRendition","name":"largeHorizontalJumbo","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-largeHorizontalJumbo-v2.jpg"}],"bleed":null,"__typename":"ImageCrop"},{"renditions":[{"width":768,"height":507,"__typename":"ImageRendition","name":"videoLarge","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-videoLarge-v2.jpg"},{"width":440,"height":293,"__typename":"ImageRendition","name":"mediumThreeByTwo440","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-mediumThreeByTwo440-v2.jpg"},{"width":7551,"height":5037,"__typename":"ImageRendition","name":"threeByTwoLargeAt2X","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-threeByTwoLargeAt2X-v2.jpg"},{"width":1500,"height":1001,"__typename":"ImageRendition","name":"threeByTwoMediumAt2X","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-threeByTwoMediumAt2X-v2.jpg"}],"bleed":null,"__typename":"ImageCrop"}],"url":"/imagepages/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz.html","summary":"","headline":{"seo":"","default":"","sentence":"","__typename":"CreativeWorkHeadline"},"bylines":[],"language":null,"firstPublished":"2023-04-11T17:15:49.000Z","lastMajorModification":"2026-11-09T21:55:34.385Z","lastModified":"2026-11-09T21:55:34.385Z","credits":[],"caption":{"text":"","__typename":"TextOnlyDocumentBlock"},"seoCrops":[{"renditions":[{"name":"articleLarge","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-articleLarge.jpg","width":600,"height":400,"__typename":"ImageRendition"},{"name":"jumbo","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-jumbo.jpg","width":1024,"height":683,"__typename":"ImageRendition"},{"name":"superJumbo","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-superJumbo.jpg","width":2048,"height":1366,"__typename":"ImageRendition"}],"__typename":"ImageCrop"},{"renditions":[{"name":"mediumSquareAt3X","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-mediumSquareAt3X-v2.jpg","width":1800,"height":1801,"__typename":"ImageRendition"}],"__typename":"ImageCrop"},{"renditions":[{"name":"videoLarge","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-videoLarge-v2.jpg","width":768,"height":507,"__typename":"ImageRendition"},{"name":"mediumThreeByTwo440","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-mediumThreeByTwo440-v2.jpg","width":440,"height":293,"__typename":"ImageRendition"},{"name":"threeByTwoLargeAt2X","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-threeByTwoLargeAt2X-v2.jpg","width":7551,"height":5037,"__typename":"ImageRendition"}],"__typename":"ImageCrop"},{"renditions":[{"name":"videoSixteenByNineJumbo1600","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-videoSixteenByNineJumbo1600-v2.jpg","width":1600,"height":901,"__typename":"ImageRendition"}],"__typename":"ImageCrop"},{"renditions":[{"name":"facebookJumbo","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-facebookJumbo-v2.jpg","width":1050,"height":550,"__typename":"ImageRendition"}],"__typename":"ImageCrop"},{"renditions":[{"name":"googleFourByThree","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-googleFourByThree-v2.jpg","width":800,"height":600,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}]},"__typename":"ScoopRecipeHeaderMedia","images":[],"videos":[]},"ckgAdTargetingParams":[{"key":"edcoll","value":"1761717,7204666,18131908,38688598,45021213,112037696,139478308","__typename":"CkgAdTargetingParam"}],"ingredients":{"doc":{"content":[{"content":[{"content":[{"content":[{"text":"1 cup/226 grams unsalted butter","type":"text"}],"type":"paragraph"}],"type":"list_item"},{"content":[{"content":[{"text":"2 ½ cups/320 grams all-purpose flour","type":"text"}],"type":"paragraph"}],"type":"list_item"},{"content":[{"content":[{"text":"1 teaspoon baking soda","type":"text"}],"type":"paragraph"}],"type":"list_item"},{"content":[{"content":[{"text":"1 teaspoon fine sea salt","type":"text"}],"type":"paragraph"}],"type":"list_item"},{"content":[{"content":[{"text":"½ teaspoon ground cinnamon (optional)","type":"text"}],"type":"paragraph"}],"type":"list_item"},{"content":[{"content":[{"text":"1 cup/220 grams light brown sugar","type":"text"}],"type":"paragraph"}],"type":"list_item"},{"content":[{"content":[{"text":"¼ cup/50 grams granulated sugar","type":"text"}],"type":"paragraph"}],"type":"list_item"},{"content":[{"content":[{"text":"1 large egg plus 1 egg yolk, at room temperature","type":"text"}],"type":"paragraph"}],"type":"list_item"},{"content":[{"content":[{"text":"2 teaspoons vanilla extract","type":"text"}],"type":"paragraph"}],"type":"list_item"},{"content":[{"content":[{"text":"12 ounces semisweet chocolate, preferably from a bar, roughly chopped (or use 12 ounces chocolate chips) ","type":"text"}],"type":"paragraph"}],"type":"list_item"},{"content":[{"content":[{"text":"Flaky sea salt (optional), for topping","type":"text"}],"type":"paragraph"}],"type":"list_item"}],"type":"bullet_list"}],"type":"scoop_recipe_ingredients_body"},"textContent":"1 cup/226 grams unsalted butter\n2 ½ cups/320 grams all-purpose flour\n1 teaspoon baking soda\n1 teaspoon fine sea salt\n½ teaspoon ground cinnamon (optional)\n1 cup/220 grams light brown sugar\n¼ cup/50 grams granulated sugar\n1 large egg plus 1 egg yolk, at room temperature\n2 teaspoons vanilla extract\n12 ounces semisweet chocolate, preferably from a bar, roughly chopped (or use 12 ounces chocolate chips) \nFlaky sea salt (optional), for topping","__typename":"ScoopRecipeIngredientsBodyDoc"},"preparation":{"doc":{"content":[{"attrs":{"scoopRecipeStepImages":null},"content":[{"text":"In a medium saucepan over medium heat, melt the butter, stirring and swirling the pan often, until the butter foams, turns golden brown and smells nutty, about 5 minutes. Pour into a large bowl and set aside to cool.","type":"text"}],"type":"step"},{"attrs":{"scoopRecipeStepImages":null},"content":[{"text":"In a medium bowl, whisk together the flour, baking soda, salt and cinnamon, if you like. Line 2 rimmed sheet pans with parchment paper.","type":"text"}],"type":"step"},{"attrs":{"scoopRecipeStepImages":null},"content":[{"text":"Add the sugars to the melted brown butter; mix until combined. Add the egg, egg yolk and vanilla extract and stir until combined. Add the flour mixture and stir until well combined.","type":"text"}],"type":"step"},{"attrs":{"scoopRecipeStepImages":null},"content":[{"text":"Stir in the chocolate. Working one at a time, scoop out a ¼ cup of the dough and roll into a ball. Place the balls on the prepared sheet pans, and chill for 1 hour and up to 24 hours.","type":"text"}],"type":"step"},{"attrs":{"scoopRecipeStepImages":null},"content":[{"text":"When ready to bake, heat oven to 350 degrees. Bake just until the edges start to turn golden, rotating halfway through, about 15 minutes.","type":"text"}],"type":"step"},{"attrs":{"scoopRecipeStepImages":null},"content":[{"text":"Remove from the oven and bang the pan on the counter. (This creates a flatter, chewier cookie.) Sprinkle cookies with flaky sea salt, if you like. Let sit on the baking sheets for 5 minutes before moving to a cooling rack to cool completely. Store cookies in an airtight container at room temperature for up to 3 days.","type":"text"}],"type":"step"}],"type":"scoop_recipe_preparation"},"textContent":"In a medium saucepan over medium heat, melt the butter, stirring and swirling the pan often, until the butter foams, turns golden brown and smells nutty, about 5 minutes. Pour into a large bowl and set aside to cool.\nIn a medium bowl, whisk together the flour, baking soda, salt and cinnamon, if you like. Line 2 rimmed sheet pans with parchment paper.\nAdd the sugars to the melted brown butter; mix until combined. Add the egg, egg yolk and vanilla extract and stir until combined. Add the flour mixture and stir until well combined.\nStir in the chocolate. Working one at a time, scoop out a ¼ cup of the dough and roll into a ball. Place the balls on the prepared sheet pans, and chill for 1 hour and up to 24 hours.\nWhen ready to bake, heat oven to 350 degrees. Bake just until the edges start to turn golden, rotating halfway through, about 15 minutes.\nRemove from the oven and bang the pan on the counter. (This creates a flatter, chewier cookie.) Sprinkle cookies with flaky sea salt, if you like. Let sit on the baking sheets for 5 minutes before moving to a cooling rack to cool completely. Store cookies in an airtight container at room temperature for up to 3 days.","__typename":"ScoopRecipePreparationDoc","references":[]},"yield":{"notes":"About 16 cookies ","servings":[{"count":16,"unit":"cookies","rangeEnd":null,"__typename":"ScoopRecipeServing"}],"__typename":"ScoopRecipeYield"},"structuredIngredientsBeta":[{"ingredientsBeta":[{"name":"unsalted butter","__typename":"ScoopRecipeStructuredIngredientBeta"}],"__typename":"ScoopRecipeStructuredIngredientListItemBeta"},{"ingredientsBeta":[{"name":"all-purpose flour","__typename":"ScoopRecipeStructuredIngredientBeta"}],"__typename":"ScoopRecipeStructuredIngredientListItemBeta"},{"ingredientsBeta":[{"name":"baking soda","__typename":"ScoopRecipeStructuredIngredientBeta"}],"__typename":"ScoopRecipeStructuredIngredientListItemBeta"},{"ingredientsBeta":[{"name":"fine sea salt","__typename":"ScoopRecipeStructuredIngredientBeta"}],"__typename":"ScoopRecipeStructuredIngredientListItemBeta"},{"ingredientsBeta":[{"name":"cinnamon","__typename":"ScoopRecipeStructuredIngredientBeta"}],"__typename":"ScoopRecipeStructuredIngredientListItemBeta"},{"ingredientsBeta":[{"name":"light brown sugar","__typename":"ScoopRecipeStructuredIngredientBeta"}],"__typename":"ScoopRecipeStructuredIngredientListItemBeta"},{"ingredientsBeta":[{"name":"granulated sugar","__typename":"ScoopRecipeStructuredIngredientBeta"}],"__typename":"ScoopRecipeStructuredIngredientListItemBeta"},{"ingredientsBeta":[{"name":"egg","__typename":"ScoopRecipeStructuredIngredientBeta"}],"__typename":"ScoopRecipeStructuredIngredientListItemBeta"},{"ingredientsBeta":[{"name":"vanilla extract","__typename":"ScoopRecipeStructuredIngredientBeta"}],"__typename":"ScoopRecipeStructuredIngredientListItemBeta"},{"ingredientsBeta":[