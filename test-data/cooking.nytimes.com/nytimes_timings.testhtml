n></button> <!-- -->or<!-- --> <button class="button_button__tgtQk button_unstyled__DbQ5k popover_popover--logged-out-action__FUUmm" type="button"><span class="button_buttonText__75JJj">sign up</span></button> <!-- -->to print this recipe.</p></div></div></div></div></li></ul></div><div class="adunit_ad-unit__IhpkS adunit_ad-unit__IhpkS"><p class="adunit_label__dR61K">Advertisement</p><div class="adunit_ad__LrqJ6 adunit_is_standard__sXyi_"></div></div><div data-testid="recipe-body" class="recipebody_body-container__GfPut"><hr class="divider_divider__PSzI_ recipebody_ingredients-horizontal-rule__o77oZ divider_thick__Jk7ex"/><div class="recipebody_ingredients-block__OFg5G"><div class="ingredients_ingredients__FLjsC"><h2 class="pantry--title-section-alternate sectionheader_title__5aon0 ingredients_heading__RdSek">Ingredients</h2><div class="ingredients_recipeYield__DN65p"><span class="pantry--ui-strong ingredients_fontOverride__W_vGL">Yield:</span><span class="pantry--ui ingredients_fontOverride__W_vGL">About 16 cookies </span></div><ul><li><p class="pantry--ui ingredient_ingredient__rfjvs">1 cup/226 grams unsalted butter</p></li><li><p class="pantry--ui ingredient_ingredient__rfjvs">2 ½ cups/320 grams all-purpose flour</p></li><li><p class="pantry--ui ingredient_ingredient__rfjvs">1 teaspoon baking soda</p></li><li><p class="pantry--ui ingredient_ingredient__rfjvs">1 teaspoon fine sea salt</p></li><li><p class="pantry--ui ingredient_ingredient__rfjvs">½ teaspoon ground cinnamon (optional)</p></li><li><p class="pantry--ui ingredient_ingredient__rfjvs">1 cup/220 grams light brown sugar</p></li><li><p class="pantry--ui ingredient_ingredient__rfjvs">¼ cup/50 grams granulated sugar</p></li><li><p class="pantry--ui ingredient_ingredient__rfjvs">1 large egg plus 1 egg yolk, at room temperature</p></li><li><p class="pantry--ui ingredient_ingredient__rfjvs">2 teaspoons vanilla extract</p></li><li><p class="pantry--ui ingredient_ingredient__rfjvs">12 ounces semisweet chocolate, preferably from a bar, roughly chopped (or use 12 ounces chocolate chips) </p></li><li><p class="pantry--ui ingredient_ingredient__rfjvs">Flaky sea salt (optional), for topping</p></li></ul><div class="ingredients_buttons__DxZKd"><div class="ingredients_ctaRow__bKn5B"><button class="button_button__tgtQk button_default__wXRq7 grocerylist_groceryListSoloBtn__NN07g" type="button"><svg width="18" height="20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="grocerylist_groceryListIcon__KRlcn"><mask id="grocery-list_svg__a" maskUnits="userSpaceOnUse" x="-0.887" y="-0.887" width="19" height="21" fill="#000"><path fill="#fff" d="M-.887-.887h19v21h-19z"></path><path d="M4.671 4.097c-.25 0-.447-.068-.59-.204-.142-.136-.214-.327-.214-.572v-.824c0-.246.072-.436.214-.572.143-.136.34-.204.59-.204h.778c.029-.445.22-.824.573-1.137.36-.314.787-.47 1.283-.47.496 0 .92.156 1.274.47.36.313.553.693.582 1.137h.786c.251 0 .448.068.59.204.143.136.214.326.214.572v.824c0 .245-.071.436-.214.572-.142.136-.339.204-.59.204H4.671Zm2.634-1.631c.21 0 .388-.068.53-.204a.64.64 0 0 0 .214-.478.633.633 0 0 0-.214-.487.738.738 0 0 0-.53-.203.758.758 0 0 0-.53.203.633.633 0 0 0-.214.487.64.64 0 0 0 .214.478.758.758 0 0 0 .53.204Zm-4.54 16.647c-.884 0-1.549-.206-1.993-.62-.44-.407-.659-1.021-.659-1.842V4.763c0-.805.211-1.416.633-1.835.428-.418 1.069-.627 1.924-.627h.205a.57.57 0 0 0-.008.102V3.203c0 .146.011.267.034.36h-.197c-.404 0-.71.11-.915.33-.2.22-.299.515-.299.886v11.856c0 .392.114.693.342.902.228.21.564.314 1.01.314h8.935c.445 0 .778-.105 1-.314.229-.209.343-.51.343-.902v-5.457l1.377-1.263v6.736c0 .82-.223 1.435-.667 1.843-.44.413-1.1.62-1.984.62H2.764ZM13.12 5.98v-1.2c0-.371-.103-.666-.308-.886-.2-.22-.499-.33-.898-.33h-.205c.023-.093.034-.214.034-.36V2.403a.57.57 0 0 0-.008-.102h.205c.832 0 1.465.188 1.898.565.44.376.659.907.659 1.592v.258l-.12.11-.12.11-1.137 1.043ZM2.995 7.986a.45.45 0 0 1 .154-.345.55.55 0 0 1 .385-.149h7.55a.63.63 0 0 1 .309.07l-.993.91H3.534a.568.56