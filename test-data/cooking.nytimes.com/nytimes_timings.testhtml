times.com/recipes/1024188-fried-green-tomatoes","sourceId":"1024188","badge":null,"consolidatedBylineString":"Millie Peartree","totalTimeDisplay":"1 hour","headline":{"default":"Fried Green Tomatoes","__typename":"CreativeWorkHeadline"},"rating":{"count":130,"roundedAverage":3,"__typename":"AggregateRecipeRating"},"promotionalMedia":{"__typename":"Image"},"promotionalImageOverride":null},"__typename":"RecipeOrScoopRecipeEdge"},{"node":{"uri":"nyt://recipe/6b1b95ae-e18c-5156-ae3c-14da373e1fce","promotionalImage":{"__typename":"PromotionalImage","image":{"altText":"","__typename":"Image","cardCrops":[{"bleed":null,"renditions":[{"name":"mediumThreeByTwo440","url":"https://static01.nyt.com/images/2025/07/11/multimedia/MP-Chicken-Tenders-ftlg/MP-Chicken-Tenders-ftlg-mediumThreeByTwo440.jpg","width":440,"height":293,"__typename":"ImageRendition"},{"name":"mediumThreeByTwo252","url":"https://static01.nyt.com/images/2025/07/11/multimedia/MP-Chicken-Tenders-ftlg/MP-Chicken-Tenders-ftlg-mediumThreeByTwo252.jpg","width":252,"height":168,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}],"largeCardCrops":[{"bleed":null,"renditions":[{"name":"square320","url":"https://static01.nyt.com/images/2025/07/11/multimedia/MP-Chicken-Tenders-ftlg/MP-Chicken-Tenders-ftlg-square320.jpg","width":320,"height":320,"__typename":"ImageRendition"},{"name":"square640","url":"https://static01.nyt.com/images/2025/07/11/multimedia/MP-Chicken-Tenders-ftlg/MP-Chicken-Tenders-ftlg-square640.jpg","width":640,"height":640,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}]}},"__typename":"Recipe","url":"https://cooking.nytimes.com/recipes/1027014-chicken-tenders","sourceId":"1027014","badge":null,"consolidatedBylineString":"Millie Peartree","totalTimeDisplay":"50 minutes","headline":{"default":"Chicken Tenders","__typename":"CreativeWorkHeadline"},"rating":{"count":208,"roundedAverage":5,"__typename":"AggregateRecipeRating"},"promotionalMedia":{"__typename":"Image"},"promotionalImageOverride":null},"__typename":"RecipeOrScoopRecipeEdge"},{"node":{"uri":"nyt://recipe/a565307f-65ab-538b-9214-5a4967ffb11e","promotionalImage":{"__typename":"PromotionalImage","image":{"altText":"","__typename":"Image","cardCrops":[{"bleed":null,"renditions":[{"name":"mediumThreeByTwo440","url":"https://static01.nyt.com/images/2023/06/09/multimedia/09juneteenthrex2-hushpuppies-kgph/09juneteenthrex2-hushpuppies-kgph-mediumThreeByTwo440.jpg","width":440,"height":293,"__typename":"ImageRendition"},{"name":"mediumThreeByTwo252","url":"https://static01.nyt.com/images/2023/06/09/multimedia/09juneteenthrex2-hushpuppies-kgph/09juneteenthrex2-hushpuppies-kgph-mediumThreeByTwo252.jpg","width":252,"height":168,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}],"largeCardCrops":[{"bleed":null,"renditions":[{"name":"square320","url":"https://static01.nyt.com/images/2023/06/09/multimedia/09juneteenthrex2-hushpuppies-kgph/09juneteenthrex2-hushpuppies-kgph-square320.jpg","width":320,"height":320,"__typename":"ImageRendition"},{"name":"square640","url":"https://static01.nyt.com/images/2023/06/09/multimedia/09juneteenthrex2-hushpuppies-kgph/09juneteenthrex2-hushpuppies-kgph-square640.jpg","width":640,"height":640,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}]}},"__typename":"Recipe","url":"https://cooking.nytimes.com/recipes/1024212-hush-puppies","sourceId":"1024212","badge":null,"consolidatedBylineString":"Millie Peartree","totalTimeDisplay":"30 minutes ","headline":{"default":"Hush Puppies","__typename":"CreativeWorkHeadline"},"rating":{"count":214,"roundedAverage":4,"__typename":"AggregateRecipeRating"},"promotionalMedia":{"__typename":"Image"},"promotionalImageOverride":null},"__typename":"RecipeOrScoopRecipeEdge"},{"node":{"uri":"nyt://recipe/bbb9482d-94cd-5c88-857d-baaf602a08b3","promotionalImage":{"__typename":"PromotionalImage","image":{"altText":"","__typename":"Image","cardCrops":[{"bleed":null,"renditions":[{"name":"mediumThreeByTwo440","url":"https://static01.nyt.com/images/2023/06/09/multimedia/09juneteenthrex1-chicken-mfwq/09juneteenthrex1-chicken-mfwq-mediumThreeByTwo440.jpg","width":440,"height":293,"__typename":"ImageRendition"},{"name":"mediumThreeByTwo252","url":"https://static01.nyt.com/images/2023/06/09/multimedia/09juneteenthrex1-chicken-mfwq/09juneteenthrex1-chicken-mfwq-mediumThreeByTwo252.jpg","width":252,"height":168,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}],"largeCardCrops":[{"bleed":null,"renditions":[{"name":"square320","url":"https://static01.nyt.com/images/2023/06/09/multimedia/09juneteenthrex1-chicken-mfwq/09juneteenthrex1-chicken-mfwq-square320.jpg","width":320,"height":320,"__typename":"ImageRendition"},{"name":"square640","url":"https://static01.nyt.com/images/2023/06/09/multimedia/09juneteenthrex1-chicken-mfwq/09juneteenthrex1-chicken-mfwq-square640.jpg","width":640,"height":640,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}]}},"__typename":"Recipe","url":"https://cooking.nytimes.com/recipes/1024211-baked-chicken-with-hibiscus-bbq-sauce","sourceId":"1024211","badge":null,"consolidatedBylineString":"Millie Peartree","totalTimeDisplay":"1 3/4 hours","headline":{"default":"Baked Chicken With Hibiscus BBQ Sauce","__typename":"CreativeWorkHeadline"},"rating":{"count":95,"roundedAverage":5,"__typename":"AggregateRecipeRating"},"promotionalMedia":{"__typename":"Image"},"promotionalImageOverride":null},"__typename":"RecipeOrScoopRecipeEdge"},{"node":{"uri":"nyt://recipe/f186b572-737f-57e0-9de7-046680332490","promotionalImage":{"__typename":"PromotionalImage","image":{"altText":"","__typename":"Image","cardCrops":[{"bleed":null,"renditions":[{"name":"mediumThreeByTwo440","url":"https://static01.nyt.com/images/2022/08/29/dining/mp-biscuits-and-gravy-1/mp-biscuits-and-gravy-1-mediumThreeByTwo440.jpg","width":440,"height":293,"__typename":"ImageRendition"},{"name":"mediumThreeByTwo252","url":"https://static01.nyt.com/images/2022/08/29/dining/mp-biscuits-and-gravy-1/mp-biscuits-and-gravy-1-mediumThreeByTwo252.jpg","width":252,"height":168,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}],"largeCardCrops":[{"bleed":null,"renditions":[{"name":"square320","url":"https://static01.nyt.com/images/2022/08/29/dining/mp-biscuits-and-gravy-1/mp-biscuits-and-gravy-1-square320.jpg","width":320,"height":320,"__typename":"ImageRendition"},{"name":"square640","url":"https://static01.nyt.com/images/2022/08/29/dining/mp-biscuits-and-gravy-1/mp-biscuits-and-gravy-1-square640.jpg","width":640,"height":640,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}]}},"__typename":"Recipe","url":"https://cooking.nytimes.com/recipes/1023438-biscuits-and-gravy","sourceId":"1023438","badge":null,"consolidatedBylineString":"Millie Peartree","totalTimeDisplay":"40 minutes","headline":{"default":"Biscuits and Gravy","__typename":"CreativeWorkHeadline"},"rating":{"count":431,"roundedAverage":4,"__typename":"AggregateRecipeRating"},"promotionalMedia":{"__typename":"Image"},"promotionalImageOverride":null},"__typename":"RecipeOrScoopRecipeEdge"},{"node":{"uri":"nyt://recipe/e63c645b-0666-502e-94cc-16a0b6d45a3c","promotionalImage":{"__typename":"PromotionalImage","image":{"altText":"A white ceramic plate holds a fillet of salmon with crispy skin and Cajun seasoning as well as roast baby potatoes and spears of asparagus.","__typename":"Image","cardCrops":[{"bleed":null,"renditions":[{"name":"mediumThreeByTwo440","url":"https://static01.nyt.com/images/2021/03/21/dining/mp-cajun-salmon/mp-cajun-salmon-mediumThreeByTwo440.jpg","width":440,"height":293,"__typename":"ImageRendition"},{"name":"mediumThreeByTwo252","url":"https://static01.nyt.com/images/2021/03/21/dining/mp-cajun-salmon/mp-cajun-salmon-mediumThreeByTwo252.jpg","width":252,"height":168,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}],"largeCardCrops":[{"bleed":null,"renditions":[{"name":"square320","url":"https://static01.nyt.com/images/2021/03/21/dining/mp-cajun-salmon/mp-cajun-salmon-square320.jpg","width":320,"height":320,"__typename":"ImageRendition"},{"name":"square640","url":"https://static01.nyt.com/images/2021/03/21/dining/mp-cajun-salmon/mp-cajun-salmon-square640.jpg","width":640,"height":640,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}]}},"__typename":"Recipe","url":"https://cooking.nytimes.com/recipes/1021930-sheet-pan-cajun-salmon","sourceId":"1021930","badge":null,"consolidatedBylineString":"Millie Peartree","totalTimeDisplay":"30 minutes","headline":{"default":"Sheet-Pan Cajun Salmon","__typename":"CreativeWorkHeadline"},"rating":{"count":1215,"roundedAverage":4,"__typename":"AggregateRecipeRating"},"promotionalMedia":{"__typename":"Image"},"promotionalImageOverride":null},"__typename":"RecipeOrScoopRecipeEdge"},{"node":{"uri":"nyt://recipe/b6a7db2e-b2fb-513a-9386-e61c543157f4","promotionalImage":{"__typename":"PromotionalImage","image":{"altText":"","__typename":"Image","cardCrops":[{"bleed":null,"renditions":[{"name":"mediumThreeByTwo440","url":"https://static01.nyt.com/images/2024/03/28/multimedia/mp-jerk-chicken-pot-pie-tpzc/mp-jerk-chicken-pot-pie-tpzc-mediumThreeByTwo440.jpg","width":440,"height":293,"__typename":"ImageRendition"},{"name":"mediumThreeByTwo252","url":"https://static01.nyt.com/images/2024/03/28/multimedia/mp-jerk-chicken-pot-pie-tpzc/mp-jerk-chicken-pot-pie-tpzc-mediumThreeByTwo252.jpg","width":252,"height":168,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}],"largeCardCrops":[{"bleed":null,"renditions":[{"name":"square320","url":"https://static01.nyt.com/images/2024/03/28/multimedia/mp-jerk-chicken-pot-pie-tpzc/mp-jerk-chicken-pot-pie-tpzc-square320.jpg","width":320,"height":320,"__typename":"ImageRendition"},{"name":"square640","url":"https://static01.nyt.com/images/2024/03/28/multimedia/mp-jerk-chicken-pot-pie-tpzc/mp-jerk-chicken-pot-pie-tpzc-square640.jpg","width":640,"height":640,"__typename":"ImageRendition"}],"__typename":"ImageCrop"}]}},"__typename":"Recipe","url":"https://cooking.nytimes.com/recipes/1025234-jerk-chicken-pot-pie","sourceId":"1025234","badge":null,"consolidatedBylineString":"Millie Peartree","totalTimeDisplay":"2 hours","headline":{"default":"Jerk Chicken Pot Pie","__typename":"CreativeWorkHeadline"},"rating":{"count":89,"roundedAverage":4,"__typename":"AggregateRecipeRating"},"promotionalMedia":{"__typename":"Image"},"promotionalImageOverride":null},"__typename":"RecipeOrScoopRecipeEdge"}],"__typename":"RecipeOrScoopRecipeConnection"},"__typename":"RecipeCarousel"}]},"meta":{"description":"There is nothing more magical than a gooey-centered, crispy-edged chocolate chip cookie. What makes this particular recipe especially enchanting is the inclusion of brown butter.","disableTitleBranding":true,"imageUrl":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-facebookJumbo-v2.jpg","isRecipeBoxRedesignEnabled":false,"isSocialGift":false,"jsonLD":[{"@context":"https://schema.org","@id":"urn:nyt:ScoopRecipe:ad130c56911d57d3b3dda7e1d82d6e3c","@type":"Recipe","aggregateRating":{"@type":"AggregateRating","ratingCount":3795,"ratingValue":5},"author":{"@id":"nyt://person/2a04bf4d-e62e-5d13-95e7-75e80d8a8289","@type":"Person","name":"Millie Peartree","sameAs":"https://www.nytimes.com/by/millie-peartree","url":"https://cooking.nytimes.com/author/millie-peartree"},"comment":[{"@type":"Comment","author":{"@type":"Person","name":"Sonja"},"datePublished":"2026-11-11T05:50:30Z","text":"Excellent chocolate chip cookie recipe - maybe even the best. I made smaller cookies and they turned out great."},{"@type":"Comment","author":{"@type":"Person","name":"Allie"},"datePublished":"2026-11-11T03:06:40Z","text":"This turned out terribly.  Crumbly and dry.  As others have mentioned, the ratios were off.  Not enough sugar and too much flour.  Stay away!"},{"@type":"Comment","author":{"@type":"Person","name":"Julie C￼"},"datePublished":"2026-10-28T10:42:07Z","text":"Thick and delicious. I followed the recipe exactly (except placed ice cream scoops of cookie dough in a bowl in the fridge instead of on two cookie sheets, as others had suggested). The cookie texture is more like a cake than your typical Tollhouse cookie. They were not dry at all."},{"@type":"Comment","author":{"@type":"Person","name":"Kat"},"datePublished":"2026-10-26T20:41:49Z","text":"I followed the recipe and was hoping for gooey cookies but I have to agree with a few people in the comments; it was too much flour. The flavor was great!"},{"@type":"Comment","author":{"@type":"Person","name":"Marie"},"datePublished":"2026-10-20T00:48:54Z","text":"How many cookies in a serving-- is ONE cookie 350 calories?"},{"@type":"Comment","author":{"@type":"Person","name":"NYTimes_Abigail"},"datePublished":"2026-10-15T10:05:54Z","text":"Yes, that technique works, but with a couple of caveats regarding how brown butter behaves compared to standard softened butter.\n\nWhen you brown butter, you evaporate its water content and leave behind milk solids that toast. If you chill liquid brown butter until it solidifies and then bring it back to a soft, almost-room-temperature state, you can cream it with sugars to incorporate air much like traditional creaming."},{"@type":"Comment","author":{"@type":"Person","name":"prettyNaomi12"},"datePublished":"2026-10-14T09:07:40Z","text":"Could the browned butter be cooled to room temp, chilled until re-set, and then brought back to almost room before whipping it with the sugars?"},{"@type":"Comment","author":{"@type":"Person","name":"Gail"},"datePublished":"2026-10-13T19:54:37Z","text":"These are the worst tasting chocolate chip cookies I have ever made, and I followed the directions exactly"},{"@type":"Comment","author":{"@type":"Person","name":"GArthur"},"datePublished":"2026-09-24T20:13:06Z","text":"After my wife and my kids, these cookies are the love of my life! I follow the recipe mostly as is with a few alterations: I use broken up burnt caramel dark chocolate bars and chopped pecans. I also make the cookies smaller and usually get about 30 cookies. I’m in heaven."},{"@type":"Comment","author":{"@type":"Person","name":"Kate Gillis"},"datePublished":"2026-09-16T23:07:31Z","text":"These are the best cookies in the history of ever. At my house, we simply refer to them as THE COOKIES. Only thing I would suggest is buying the best chocolate chips you can get your mitts on. Oherwise, change nothing, but keep an eye on them in the oven and check them often."},{"@type":"Comment","author":{"@type":"Person","name":"Kevin"},"datePublished":"2026-08-31T03:43:03Z","text":"Could the browned butter be cooled to room temp, chilled until re-set, and then brought back to almost room before whipping it with the sugars? Thank you."},{"@type":"Comment","author":{"@type":"Person","name":"Chad"},"datePublished":"2026-08-29T21:54:16Z","text":"These have potential, but I think they’re too big, the chocolate-to-dough ratio is off, and I didn’t love the cinnamon.  If I were to make again, I’d use fewer chocolate chips, leave out the cinnamon, and make them a bit smaller (I guess at that point they’re mostly just standard chocolate chip cookies lol…but the browned butter would still add a little something)"},{"@type":"Comment","author":{"@type":"Person","name":"Marcie Damien"},"datePublished":"2026-08-20T06:47:34Z","text":"Dry/not dry: depends on the size/volume of eggs used. I wish we could know the weight in grams of the ones that were successful, as a unit of 1 large egg can vary so much from place to place."},{"@type":"Comment","author":{"@type":"Person","name":"Barb"},"datePublished":"2026-08-14T16:44:48Z","text":"This recipe is a revelation. I’ve tried so many times to make good chocolate chip cookies without much success - to flat - too hard,  not good enough. These cookies are just right!   I’m convinced it’s from waiting 72 hours for the dough to rest/moisten in other words taking your time ! it’s so totally worth it. Thank you NYT"},{"@type":"Comment","author":{"@type":"Person","name":"Ellen B Tabor"},"datePublished":"2026-10-10T21:44:04Z","text":"I also chill my cookie dough before baking, usually overnight. Then I scoop the cookies and bake some and freeze the rest. I want very chewy cookies, and this trick makes that happen."},{"@type":"Comment","author":{"@type":"Person","name":"Priscilla"},"datePublished":"2026-08-12T20:24:46Z","text":"I have made these cookies probably a million times and these are my tips. \n1. Let the brown butter cool or your chocolate will melt - although I don’t let it cool ALL the way because I kind of like a small amount of melting \n2. I add chopped pecans and it adds to the nuttiness and texture. \n3. I just cool the dough in the fridge for like 30 mins and then scoop and bake and it’s always worked out well for me. \n4. Vanilla salt is an amazing topping for it"},{"@type":"Comment","author":{"@type":"Person","name":"Priscilla"},"datePublished":"2026-08-12T20:24:45Z","text":"I am a trained Chef and baker and this is the only cookie recipe I make anymore. I’ve waited to comment because I kept thinking I would move on to other cookies. But much like my own monotony, it is unfortunate I have fallen so in love and with this cookie will forever stay."},{"@type":"Comment","author":{"@type":"Person","name":"Laura"},"datePublished":"2023-04-12T20:44:46Z","text":"Suggest that the baking time with cookies this large is going to be more like 19-20 minutes for me.\n\nLove the tip about banging the tray on the counter.  That is a boss move and I did it.  \n\nThe recipe really isn’t that salty, so the flaky salt on top is definitely welcome.\n\nAnd the verdict:  these are great cookies!  Love the chocolate to cookie ratio, and the cinnamon and brown sugar in the background just elevate the toastiness of the brown butter.  Where has this been all my life?"},{"@type":"Comment","author":{"@type":"Person","name":"Ann O’Neill"},"datePublished":"2023-04-17T16:12:49Z","text":"Same fridge issue with an alternative to placing pre-scooped balls into a smaller container. Try rolling the dough into a log and refrigerating the log. Cut into the same number as the recipe’s yield and they’ll be a like size."},{"@type":"Comment","author":{"@type":"Person","name":"Val"},"datePublished":"2023-04-13T11:24:11Z","text":"As for not enough room to chill on a sheet pan, I roll dough into balls and just use the mixing bowl to chill them in the fridge."},{"@type":"Comment","author":{"@type":"Person","name":"TL"},"datePublished":"2023-08-17T11:14:37Z","text":"Underbaking these is key. I overbaked the first few and they had all the appeal of hockey pucks. I underbaked the next ones and then smashed them a bit with a spoon to flatten them and give the flaky salt somewhere to stick. They were so good they made my husband lose his train of thought."},{"@type":"Comment","author":{"@type":"Person","name":"RL"},"datePublished":"2023-04-13T14:46:47Z","text":"Melting the 2 sticks of unsalted butter is step 1, but you want to take it to step 2, where you keep it on the heat until it toasts/browns - a good indicator that it's near ready is when you stop hearing sizzling sounds (keep scraping the pan with a spatula so that the milk solids don't stick and burn). In the end, you'll have a liquid that's the color of amber or even caramel - some like to go even darker, but once it gets to dark coffee, it's burnt. Your nose is a good guide throughout."},{"@type":"Comment","author":{"@type":"Person","name":"Terri O"},"datePublished":"2023-04-13T11:29:14Z","text":"If your cookie sheets won't fit in the refrigerator, I have placed the shaped cookies in a plastic container with parchment paper between the layers"},{"@type":"Comment","author":{"@type":"Person","name":"Beth"},"datePublished":"2023-04-13T11:29:13Z","text":"I've found that when I have covered cookie dough in a bowl and left it in the fridge that it results in a drier cookie.  I'd personally recommend wrapping the entire ball of dough in plastic/beeswax wrap before refrigeration."},{"@type":"Comment","author":{"@type":"Person","name":"NAM_WA"},"datePublished":"2023-04-12T20:44:46Z","text":"This is one of many recipes that I've noticed include placing something in the refrigerator before baking. I wonder if I am alone in not having a refrigerator empty enough to get a pan of cookies in it? Could one refrigerate the dough (in its much smaller bowl) into the fridge before scooping into balls for baking and still get satisfactory results?"},{"@type":"Comment","author":{"@type":"Person","name":"Sean"},"datePublished":"2023-04-19T11:23:06Z","text":"Since you have to refrigerate the dough first anyway, might it be easier and faster to just roll the dough into a log in plastic wrap and freeze that, then cut disks? It would save space in the freezer as well, for those of us in Europe who don't have walk-in freezers like everyone in the US (kidding, but our refrigeration is super small)."},{"@type":"Comment","author":{"@type":"Person","name":"Julie"},"datePublished":"2023-04-20T11:21:26Z","text":"Well. I devoured the comments, then made the cookies. Can't remember the last time I mixed cookie dough w a wooden spoon.  Used c. 1/2 bag of Ghirardelli semi sweets and half tsp of cinnamon.  Possibly the best ccc recipe I've ever tried, thank you."},{"@type":"Comment","author":{"@type":"Person","name":"JC"},"datePublished":"2023-04-13T14:46:47Z","text":"Brown butter is what happens when you melt the butter over the stove top until the milk solids fall to the bottom of the pot and begin to brown.   The solids can go from light brown to burnt pretty quick, so remember that carry-over heat will help them get to golden brown.  Brown butter just imparts more flavor.  Start with unsalted butter so that you can control the amount of salt that goes into the cookies, since you can't control the amount that's in the butter."},{"@type":"Comment","author":{"@type":"Person","name":"Laura"},"datePublished":"2023-04-17T17:54:20Z","text":"These were fantastic! They were so buttery and oily going into the fridge that I thought I did something wrong. I left them uncovered hoping to dry them out a touch. \nBut they turned out beautifully! \nI did add the touch of cinnamon and loved it. Very subtle, but enjoyable. I also agree that the flaky salt on top is a must! \nOurs were very much best warm. The next day they were quite dried out, even after spending the night in a covered container."},{"@type":"Comment","author":{"@type":"Person","name":"sarah"},"datePublished":"2023-12-20T02:45:56Z","text":"The perfect cookie recipe with one edit:\n\nAfter rolling into balls, place in freezer for a few hours then bake at 350 for exactly 12 min. Trust me and take them out of oven/place on cooling rack—even if you’re not convinced they’re done. Result is an amazing consistency crispy outside, chewy inside. \n\nI keep the dough balls frozen, vacuum sealed in individual portions and bake a couple at a time for fresh baked cookies every night."},{"@type":"Comment","author":{"@type":"Person","name":"Ldsse"},"datePublished":"2023-04-25T10:29:27Z","text":"Baked exactly according to the recipe. I don’t care for the cookies. The texture is quite dry — almost sandy. The dough was crumbly and did not hold together well. The finished cookies are too salty for my taste (I did not even sprinkle salt on top). The intense butter flavor is cloying and after eating 2 cookies I have indigestion. They also took quite a bit longer to prepare than other chocolate chip recipes. Lightly browning the butter took about 10 minutes not 5  as the recipe states."},{"@type":"Comment","author":{"@type":"Person","name":"D. Yorkin"},"datePublished":"2023-05-16T00:07:13Z","text":"the chocolate chips melted when i put them in - need to let the brown butter cool"}],"commentCount":464,"cookTime":"PT1H50M","cookingMethod":"Bake, Baking","copyrightHolder":{"@id":"https://cooking.nytimes.com/#publisher","@type":"Organization","name":"NYT Cooking"},"copyrightYear":2023,"dateModified":"2023-10-11T00:00:00Z","datePublished":"2023-04-11T00:00:00Z","description":"There is nothing more magical than a gooey-centered, crispy-edged chocolate chip cookie. What makes this particular recipe especially enchanting is the inclusion of brown butter. It mixes right into the dry ingredients, infusing the batter with its nutty flavor without the need for a mixer or any other special equipment. An optional dash of cinnamon has a warmth that feels like a hug, and the brown sugar gives you that chew with a slight molasses taste. Whether for a holiday or an afternoon snack, these cookies may become your go-to.","image":[{"@id":"nyt://image/c0180dcc-fcaf-52c1-8d95-6a1dde63bd6e#videoSixteenByNineJumbo1600","@type":"ImageObject","contentUrl":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-videoSixteenByNineJumbo1600-v2.jpg","creditText":"Bobbi Lin for The New York Times. Food Stylist: Maggie Ruggiero.","dateModified":"2026-11-09T21:55:34.385Z","datePublished":"2023-04-11T17:15:49.000Z","height":"901","uploadDate":"2023-04-11T17:15:49.000Z","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-videoSixteenByNineJumbo1600-v2.jpg","width":"1600"},{"@id":"nyt://image/c0180dcc-fcaf-52c1-8d95-6a1dde63bd6e#googleFourByThree","@type":"ImageObject","contentUrl":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-googleFourByThree-v2.jpg","creditText":"Bobbi Lin for The New York Times. Food Stylist: Maggie Ruggiero.","dateModified":"2026-11-09T21:55:34.385Z","datePublished":"2023-04-11T17:15:49.000Z","height":"600","uploadDate":"2023-04-11T17:15:49.000Z","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-googleFourByThree-v2.jpg","width":"800"},{"@id":"nyt://image/c0180dcc-fcaf-52c1-8d95-6a1dde63bd6e#mediumSquareAt3X","@type":"ImageObject","contentUrl":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-mediumSquareAt3X-v2.jpg","creditText":"Bobbi Lin for The New York Times. Food Stylist: Maggie Ruggiero.","dateModified":"2026-11-09T21:55:34.385Z","datePublished":"2023-04-11T17:15:49.000Z","height":"1801","uploadDate":"2023-04-11T17:15:49.000Z","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-mediumSquareAt3X-v2.jpg","width":"1800"},{"@id":"nyt://image/c0180dcc-fcaf-52c1-8d95-6a1dde63bd6e#facebookJumbo","@type":"ImageObject","contentUrl":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-facebookJumbo-v2.jpg","creditText":"Bobbi Lin for The New York Times. Food Stylist: Maggie Ruggiero.","dateModified":"2026-11-09T21:55:34.385Z","datePublished":"2023-04-11T17:15:49.000Z","height":"550","uploadDate":"2023-04-11T17:15:49.000Z","url":"https://static01.nyt.com/images/2023/04/11/multimedia/mp-chocolate-chip-cookies-vtgz/mp-chocolate-chip-cookies-vtgz-facebookJumbo-v2.jpg","width":"1050"}],"isAccessibleForFree":false,"keywords":"Brown Butter, Egg Yolk, Semisweet Chocolate, Semisweet Chocolate Chip","mainEntityOfPage":{"@id":"//cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies","@type":"WebPage","name":"Brown Butter Chocolate Chip Cookies "},"name":"Brown Butter Chocolate Chip Cookies ","nutrition":{"@type":"NutritionInformation","calories":"354","carbohydrateContent":"46.6 grams","cholesterolContent":"54.3 milligrams","fatContent":"17.1 grams","fiberContent":"1.2 grams","proteinContent":"3.7 grams","saturatedFatContent":"10.4 grams","sodiumContent":"179.3 milligrams","sugarContent":"29.9 grams","unsaturatedFatContent":"0.6 grams"},"prepTime":"PT15M","publisher":{"@id":"https://cooking.nytimes.com/#publisher","@type":"Organization","name":"NYT Cooking"},"recipeCategory":"Chocolate Chip Cookie, Dessert","recipeIngredient":["1 cup/226 grams unsalted butter","2 ½ cups/320 grams all-purpose flour","1 teaspoon baking soda","1 teaspoon fine sea salt","½ teaspoon ground cinnamon (optional)","1 cup/220 grams light brown sugar","¼ cup/50 grams granulated sugar","1 large egg plus 1 egg yolk, at room temperature","2 teaspoons vanilla extract","12 ounces semisweet chocolate, preferably from a bar, roughly chopped (or use 12 ounces chocolate chips)","Flaky sea salt (optional), for topping"],"recipeInstructions":[{"@type":"HowToStep","text":"In a medium saucepan over medium heat, melt the butter, stirring and swirling the pan often, until the butter foams, turns golden brown and smells nutty, about 5 minutes. Pour into a large bowl and set aside to cool.","url":"https://cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies#recipe-step-1"},{"@type":"HowToStep","text":"In a medium bowl, whisk together the flour, baking soda, salt and cinnamon, if you like. Line 2 rimmed sheet pans with parchment paper.","url":"https://cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies#recipe-step-2"},{"@type":"HowToStep","text":"Add the sugars to the melted brown butter; mix until combined. Add the egg, egg yolk and vanilla extract and stir until combined. Add the flour mixture and stir until well combined.","url":"https://cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies#recipe-step-3"},{"@type":"HowToStep","text":"Stir in the chocolate. Working one at a time, scoop out a ¼ cup of the dough and roll into a ball. Place the balls on the prepared sheet pans, and chill for 1 hour and up to 24 hours.","url":"https://cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies#recipe-step-4"},{"@type":"HowToStep","text":"When ready to bake, heat oven to 350 degrees. Bake just until the edges start to turn golden, rotating halfway through, about 15 minutes.","url":"https://cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies#recipe-step-5"},{"@type":"HowToStep","text":"Remove from the oven and bang the pan on the counter. (This creates a flatter, chewier cookie.) Sprinkle cookies with flaky sea salt, if you like. Let sit on the baking sheets for 5 minutes before moving to a cooling rack to cool completely. Store cookies in an airtight container at room temperature for up to 3 days.","url":"https://cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies#recipe-step-6"}],"recipeYield":"16 cookies","totalTime":"PT1H50M","url":"//cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies"},{"@context":"https://schema.org","@id":"//cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies","@type":"WebPage","author":{"@id":"nyt://person/2a04bf4d-e62e-5d13-95e7-75e80d8a8289","@type":"Person","name":"Millie Peartree","sameAs":"https://www.nytimes.com/by/millie-peartree","url":"https://cooking.nytimes.com/author/millie-peartree"},"copyrightHolder":{"@id":"https://cooking.nytimes.com/#publisher","@type":"Organization","name":"NYT Cooking"},"copyrightYear":2023,"dateModified":"2023-10-11T00:00:00Z","datePublished":"2023-04-11T00:00:00Z","description":"There is nothing more magical than a gooey-centered, crispy-edged chocolate chip cookie. What makes this particular recipe especially enchanting is the inclusion of brown butter. It mixes right into the dry ingredients, infusing the batter with its nutty flavor without the need for a mixer or any other special equipment. An optional dash of cinnamon has a warmth that feels like a hug, and the brown sugar gives you that chew with a slight molasses taste. Whether for a holiday or an afternoon snack, these cookies may become your go-to.","hasPart":{"@type":"WebPageElement","cssSelector":".recipe","isAccessibleForFree":false},"isAccessibleForFree":false,"isPartOf":{"@type":["CreativeWork","Product"],"name":"NYT Cooking","productID":"cooking.nytimes.com:basic"},"name":"Brown Butter Chocolate Chip Cookies ","publisher":{"@id":"https://cooking.nytimes.com/#publisher","@type":"Organization","name":"NYT Cooking"},"url":"//cooking.nytimes.com/recipes/1024108-brown-butter-chocolate-chip-cookies"},{"@context":"https://schema.org","@id":"https://cooking.nytimes.com/#publisher","@type":"Organization","alternateName":["nytimes cooking","New York Times Cooking"],"diversityPolicy":"https://www.nytco.com/company/diversity-and-inclusion/","ethicsPolicy":"https://www.nytco.com/company/standards-ethics/","foundingDate":"2014-09-17","logo":{"@type":"ImageObject","contentUrl":"https://static01.nyt.com/applications/cooking/623885b/assets/SiteLogoBlack-112x112.svg","creditText":"NYT Cooking","height":"112","url":"https://static01.nyt.com/applications/cooking/623885b/assets/SiteLogoBlack-112x112.svg","width":"112"},"name":"NYT Cooking","parentOrganization":{"@id":"https://www.nytimes.com/#publisher","@type":"NewsMediaOrganization","name":"The New York Times"},"sameAs":["https://www.facebook.com/nytcooking/","https://www.instagram.com/nytcooking/","https://www.youtube.com/c/NYTCooking","https://www.tiktok.com/@nytcooking","https://apps.apple.com/us/app/nyt-cooking/id911422904","https://play.google.com/store/apps/details?id=com.nytimes.cooking\u0026hl=en_US\u0026gl=US"],"url":"https://cooking.nytimes.com"},{"@context":"https://schema.org","@id":"https://www.nytimes.com/#publisher","@type":"NewsMediaOrganization","diversityPolicy":"https://www.nytco.com/company/diversity-and-inclusion/","ethicsPolicy":"https://www.nytco.com/company/standards-ethics/","foundingDate":"1851-09-18","logo":{"@type":"ImageObject","contentUrl":"https://static01.nyt.com/images/icons/t_logo_291_black.png","creditText":"The New York Times","height":"291","url":"https://static01.nyt.com/images/icons/t_logo_291_black.png","width":"291"},"masthead":"https://www.nytimes.com/interactive/2023/01/28/admin/the-new-york-times-masthead.html","name":"The New York Times","sameAs":["https://www.facebook.com/nytimes/","https://twitter.com/nytimes","https://www.instagram.com/nytimes/","https://www.youtube.com/user/TheNewYorkTimes","https://www.linkedin.com/company/the-new-york-times","https://www.wikidata.org/wiki/Q9684","https://en.wikipedia.org/wiki/The_New_York_Times"],"url":"https://www.nytimes.com/"}],"pageType":"recipe","scoopRecipeUrn":"urn:nyt:ScoopRecipe:ad130c56911d57d3b3dda7e1d82d6e3c","socialDescription":"There is nothing more magical than a gooey-centered, crispy-edged chocolate chip cookie. What makes this particular recipe especially enchanting is the inclusion of brown butter.","socialTitle":"Brown Butter Chocolate Chip Cookies  Recipe • 5★","title":"Brown Butter Chocolate Chip Cookies  Recipe","uri":"nyt://recipe/beeb97de-ce9f-5ae7-ab81-05e7b598e0f3"},"helpfulNotes":"{\"notes\":[{\"id\":\"124390795\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Laura\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"Suggest that the baking time with cookies this large is going to be more like 19-20 minutes for me.\\n\\nLove the tip about banging the tray on the counter.  That is a boss move and I did it.  \\n\\nThe recipe really isn’t that salty, so the flaky salt on top is definitely welcome.\\n\\nAnd the verdict:  these are great cookies!  Love the chocolate to cookie ratio, and the cinnamon and brown sugar in the background just elevate the toastiness of the brown butter.  Where has this been all my life?\",\"submittedAt\":\"2023-04-12T20:06:35Z\",\"acceptedAt\":\"2023-04-12T20:44:46Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":1,\"recommendedCount\":407,\"reporterReply\":false},{\"id\":\"124483536\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Ann O’Neill\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"Same fridge issue with an alternative to placing pre-scooped balls into a smaller container. Try rolling the dough into a log and refrigerating the log. Cut into the same number as the recipe’s yield and they’ll be a like size.\",\"submittedAt\":\"2023-04-17T15:51:26Z\",\"acceptedAt\":\"2023-04-17T16:12:49Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":345,\"reporterReply\":false},{\"id\":\"124397253\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Val\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"As for not enough room to chill on a sheet pan, I roll dough into balls and just use the mixing bowl to chill them in the fridge.\",\"submittedAt\":\"2023-04-13T01:18:59Z\",\"acceptedAt\":\"2023-04-13T11:24:11Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":319,\"reporterReply\":false},{\"id\":\"127074909\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"TL\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"Underbaking these is key. I overbaked the first few and they had all the appeal of hockey pucks. I underbaked the next ones and then smashed them a bit with a spoon to flatten them and give the flaky salt somewhere to stick. They were so good they made my husband lose his train of thought.\",\"submittedAt\":\"2023-08-17T03:18:07Z\",\"acceptedAt\":\"2023-08-17T11:14:37Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":287,\"reporterReply\":false},{\"id\":\"124405579\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"RL\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"Melting the 2 sticks of unsalted butter is step 1, but you want to take it to step 2, where you keep it on the heat until it toasts/browns - a good indicator that it's near ready is when you stop hearing sizzling sounds (keep scraping the pan with a spatula so that the milk solids don't stick and burn). In the end, you'll have a liquid that's the color of amber or even caramel - some like to go even darker, but once it gets to dark coffee, it's burnt. Your nose is a good guide throughout.\",\"submittedAt\":\"2023-04-13T14:24:18Z\",\"acceptedAt\":\"2023-04-13T14:46:47Z\",\"replyToID\":\"124394212\",\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":272,\"reporterReply\":false},{\"id\":\"124399404\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Terri O\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"If your cookie sheets won't fit in the refrigerator, I have placed the shaped cookies in a plastic container with parchment paper between the layers\",\"submittedAt\":\"2023-04-13T04:57:00Z\",\"acceptedAt\":\"2023-04-13T11:29:14Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":179,\"reporterReply\":false},{\"id\":\"124401358\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Beth\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"I've found that when I have covered cookie dough in a bowl and left it in the fridge that it results in a drier cookie.  I'd personally recommend wrapping the entire ball of dough in plastic/beeswax wrap before refrigeration.\",\"submittedAt\":\"2023-04-13T11:14:54Z\",\"acceptedAt\":\"2023-04-13T11:29:13Z\",\"replyToID\":\"124389187\",\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":164,\"reporterReply\":false},{\"id\":\"124389187\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"NAM_WA\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"This is one of many recipes that I've noticed include placing something in the refrigerator before baking. I wonder if I am alone in not having a refrigerator empty enough to get a pan of cookies in it? Could one refrigerate the dough (in its much smaller bowl) into the fridge before scooping into balls for baking and still get satisfactory results?\",\"submittedAt\":\"2023-04-12T19:15:47Z\",\"acceptedAt\":\"2023-04-12T20:44:46Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":5,\"recommendedCount\":129,\"reporterReply\":false},{\"id\":\"124522693\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Sean\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"Since you have to refrigerate the dough first anyway, might it be easier and faster to just roll the dough into a log in plastic wrap and freeze that, then cut disks? It would save space in the freezer as well, for those of us in Europe who don't have walk-in freezers like everyone in the US (kidding, but our refrigeration is super small).\",\"submittedAt\":\"2023-04-19T06:51:54Z\",\"acceptedAt\":\"2023-04-19T11:23:06Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":1,\"recommendedCount\":118,\"reporterReply\":false},{\"id\":\"124548019\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Julie\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"Well. I devoured the comments, then made the cookies. Can't remember the last time I mixed cookie dough w a wooden spoon.  Used c. 1/2 bag of Ghirardelli semi sweets and half tsp of cinnamon.  Possibly the best ccc recipe I've ever tried, thank you.\",\"submittedAt\":\"2023-04-20T06:31:34Z\",\"acceptedAt\":\"2023-04-20T11:21:26Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":117,\"reporterReply\":false},{\"id\":\"124404831\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"JC\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"Brown butter is what happens when you melt the butter over the stove top until the milk solids fall to the bottom of the pot and begin to brown.   The solids can go from light brown to burnt pretty quick, so remember that carry-over heat will help them get to golden brown.  Brown butter just imparts more flavor.  Start with unsalted butter so that you can control the amount of salt that goes into the cookies, since you can't control the amount that's in the butter.\",\"submittedAt\":\"2023-04-13T13:59:04Z\",\"acceptedAt\":\"2023-04-13T14:46:47Z\",\"replyToID\":\"124394212\",\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":110,\"reporterReply\":false},{\"id\":\"124485870\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Laura\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"These were fantastic! They were so buttery and oily going into the fridge that I thought I did something wrong. I left them uncovered hoping to dry them out a touch. \\nBut they turned out beautifully! \\nI did add the touch of cinnamon and loved it. Very subtle, but enjoyable. I also agree that the flaky salt on top is a must! \\nOurs were very much best warm. The next day they were quite dried out, even after spending the night in a covered container.\",\"submittedAt\":\"2023-04-17T17:21:57Z\",\"acceptedAt\":\"2023-04-17T17:54:20Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":1,\"recommendedCount\":94,\"reporterReply\":false},{\"id\":\"129914341\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"sarah\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"The perfect cookie recipe with one edit:\\n\\nAfter rolling into balls, place in freezer for a few hours then bake at 350 for exactly 12 min. Trust me and take them out of oven/place on cooling rack—even if you’re not convinced they’re done. Result is an amazing consistency crispy outside, chewy inside. \\n\\nI keep the dough balls frozen, vacuum sealed in individual portions and bake a couple at a time for fresh baked cookies every night.\",\"submittedAt\":\"2023-12-20T02:21:07Z\",\"acceptedAt\":\"2023-12-20T02:45:56Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":86,\"reporterReply\":false},{\"id\":\"124647964\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Ldsse\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"Baked exactly according to the recipe. I don’t care for the cookies. The texture is quite dry — almost sandy. The dough was crumbly and did not hold together well. The finished cookies are too salty for my taste (I did not even sprinkle salt on top). The intense butter flavor is cloying and after eating 2 cookies I have indigestion. They also took quite a bit longer to prepare than other chocolate chip recipes. Lightly browning the butter took about 10 minutes not 5  as the recipe states.\",\"submittedAt\":\"2023-04-25T03:29:36Z\",\"acceptedAt\":\"2023-04-25T10:29:27Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":9,\"recommendedCount\":78,\"reporterReply\":false},{\"id\":\"125098232\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"D. Yorkin\",\"isReporter\":false,\"location\":\"\",\"title\":\"\"},\"text\":\"the chocolate chips melted when i put them in - need to let the brown butter cool\",\"submittedAt\":\"2023-05-15T23:19:43Z\",\"acceptedAt\":\"2023-05-16T00:07:13Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":2,\"recommendedCount\":68,\"reporterReply\":false}],\"totals\":{\"all\":464,\"helpful\":116,\"private\":0},\"endCursor\":\"l-XTvwFm6eRHFf16A7dfACY7IfQw09845XruUJWynw\",\"hasNextPage\":true}","allNotes":"{\"notes\":[{\"id\":\"155548861\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Sonja\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"Excellent chocolate chip cookie recipe - maybe even the best. I made smaller cookies and they turned out great.\",\"submittedAt\":\"2026-11-11T03:43:19Z\",\"acceptedAt\":\"2026-11-11T05:50:30Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"155548158\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Allie\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"This turned out terribly.  Crumbly and dry.  As others have mentioned, the ratios were off.  Not enough sugar and too much flour.  Stay away!\",\"submittedAt\":\"2026-11-11T02:59:54Z\",\"acceptedAt\":\"2026-11-11T03:06:40Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"155168679\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Julie C￼\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"Thick and delicious. I followed the recipe exactly (except placed ice cream scoops of cookie dough in a bowl in the fridge instead of on two cookie sheets, as others had suggested). The cookie texture is more like a cake than your typical Tollhouse cookie. They were not dry at all.\",\"submittedAt\":\"2026-10-28T07:17:28Z\",\"acceptedAt\":\"2026-10-28T10:42:07Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"155130890\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Kat\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"I followed the recipe and was hoping for gooey cookies but I have to agree with a few people in the comments; it was too much flour. The flavor was great!\",\"submittedAt\":\"2026-10-26T20:40:00Z\",\"acceptedAt\":\"2026-10-26T20:41:49Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"154956598\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Marie\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"How many cookies in a serving-- is ONE cookie 350 calories?\",\"submittedAt\":\"2026-10-20T00:03:16Z\",\"acceptedAt\":\"2026-10-20T00:48:54Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"154808794\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"prettyNaomi12\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"Could the browned butter be cooled to room temp, chilled until re-set, and then brought back to almost room before whipping it with the sugars?\",\"submittedAt\":\"2026-10-14T08:13:25Z\",\"acceptedAt\":\"2026-10-14T09:07:40Z\",\"replyToID\":null,\"replies\":[{\"id\":\"154837450\",\"type\":\"userReply\",\"author\":{\"avatarURL\":null,\"name\":\"NYTimes_Abigail\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"Yes, that technique works, but with a couple of caveats regarding how brown butter behaves compared to standard softened butter.\\n\\nWhen you brown butter, you evaporate its water content and leave behind milk solids that toast. If you chill liquid brown butter until it solidifies and then bring it back to a soft, almost-room-temperature state, you can cream it with sugars to incorporate air much like traditional creaming.\",\"submittedAt\":\"2026-10-15T08:10:44Z\",\"acceptedAt\":\"2026-10-15T10:05:54Z\",\"replyToID\":\"154808794\",\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false}],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":1,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"154799166\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Gail\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"These are the worst tasting chocolate chip cookies I have ever made, and I followed the directions exactly\",\"submittedAt\":\"2026-10-13T19:19:43Z\",\"acceptedAt\":\"2026-10-13T19:54:37Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"154358691\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"GArthur\",\"isReporter\":false,\"location\":\"WA\",\"title\":\"\"},\"text\":\"After my wife and my kids, these cookies are the love of my life! I follow the recipe mostly as is with a few alterations: I use broken up burnt caramel dark chocolate bars and chopped pecans. I also make the cookies smaller and usually get about 30 cookies. I’m in heaven.\",\"submittedAt\":\"2026-09-24T19:59:43Z\",\"acceptedAt\":\"2026-09-24T20:13:06Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"154163928\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Kate Gillis\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"These are the best cookies in the history of ever. At my house, we simply refer to them as THE COOKIES. Only thing I would suggest is buying the best chocolate chips you can get your mitts on. Oherwise, change nothing, but keep an eye on them in the oven and check them often.\",\"submittedAt\":\"2026-09-16T22:37:06Z\",\"acceptedAt\":\"2026-09-16T23:07:31Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":2,\"reporterReply\":false},{\"id\":\"153756910\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Kevin\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"Could the browned butter be cooled to room temp, chilled until re-set, and then brought back to almost room before whipping it with the sugars? Thank you.\",\"submittedAt\":\"2026-08-31T03:33:18Z\",\"acceptedAt\":\"2026-08-31T03:43:03Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"153738932\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Chad\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"These have potential, but I think they’re too big, the chocolate-to-dough ratio is off, and I didn’t love the cinnamon.  If I were to make again, I’d use fewer chocolate chips, leave out the cinnamon, and make them a bit smaller (I guess at that point they’re mostly just standard chocolate chip cookies lol…but the browned butter would still add a little something)\",\"submittedAt\":\"2026-08-29T19:40:42Z\",\"acceptedAt\":\"2026-08-29T21:54:16Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"153494440\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Marcie Damien\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"Dry/not dry: depends on the size/volume of eggs used. I wish we could know the weight in grams of the ones that were successful, as a unit of 1 large egg can vary so much from place to place.\",\"submittedAt\":\"2026-08-20T04:59:58Z\",\"acceptedAt\":\"2026-08-20T06:47:34Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"153370398\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Barb\",\"isReporter\":false,\"location\":\"Edmonton Alberta Canada\",\"title\":\"\"},\"text\":\"This recipe is a revelation. I’ve tried so many times to make good chocolate chip cookies without much success - to flat - too hard,  not good enough. These cookies are just right!   I’m convinced it’s from waiting 72 hours for the dough to rest/moisten in other words taking your time ! it’s so totally worth it. Thank you NYT\",\"submittedAt\":\"2026-08-14T16:32:09Z\",\"acceptedAt\":\"2026-08-14T16:44:48Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false},{\"id\":\"153320258\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Priscilla\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"I have made these cookies probably a million times and these are my tips. \\n1. Let the brown butter cool or your chocolate will melt - although I don’t let it cool ALL the way because I kind of like a small amount of melting \\n2. I add chopped pecans and it adds to the nuttiness and texture. \\n3. I just cool the dough in the fridge for like 30 mins and then scoop and bake and it’s always worked out well for me. \\n4. Vanilla salt is an amazing topping for it\",\"submittedAt\":\"2026-08-12T20:19:10Z\",\"acceptedAt\":\"2026-08-12T20:24:46Z\",\"replyToID\":null,\"replies\":[{\"id\":\"154739542\",\"type\":\"userReply\",\"author\":{\"avatarURL\":null,\"name\":\"Ellen B Tabor\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"I also chill my cookie dough before baking, usually overnight. Then I scoop the cookies and bake some and freeze the rest. I want very chewy cookies, and this trick makes that happen.\",\"submittedAt\":\"2026-10-10T19:52:36Z\",\"acceptedAt\":\"2026-10-10T21:44:04Z\",\"replyToID\":\"153320258\",\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":0,\"reporterReply\":false}],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":1,\"recommendedCount\":1,\"reporterReply\":false},{\"id\":\"153320119\",\"type\":\"comment\",\"author\":{\"avatarURL\":null,\"name\":\"Priscilla\",\"isReporter\":false,\"location\":null,\"title\":\"\"},\"text\":\"I am a trained Chef and baker and this is the only cookie recipe I make anymore. I’ve waited to comment because I kept thinking I would move on to other cookies. But much like my own monotony, it is unfortunate I have fallen so in love and with this cookie will forever stay.\",\"submittedAt\":\"2026-08-12T20:14:10Z\",\"acceptedAt\":\"2026-08-12T20:24:45Z\",\"replyToID\":null,\"replies\":[],\"status\":\"approved\",\"isRecommended\":false,\"replyCount\":0,\"recommendedCount\":3,\"reporterReply\":false}],\"totals\":{\"all\":464,\"helpful\":116,\"private\":0},\"endCursor\":\"ORCDsTTdmUCUAYpYjuF4m1ybwhOHlonIleWA9nuCjcj671cqqI1Hemua\",\"hasNextPage\":true}","isMediaNetEnabled":true,"trendingArticles":[{"id":100000010632076,"name":"18 Healthy Sheet-Pan Dinners Because Who Has the Time for More Dishes","byline":"By Samantha Cassetty","url":"https://cooking.nytimes.com/article/healthy-sheet-pan-dinners-recipes","uri":"nyt://article/07ce5647-416a-59eb-9bab-79a16ca02579","image":{"src":{"card":"https://static01.nyt.com/images/2026/01/22/multimedia/22FD-HEALTHY-SHEET-PAN-ROUNDUP-topart-turmericchicken-cmgt/22FD-HEALTHY-SHEET-PAN-ROUNDUP-topart-turmericchicken-cmgt-master315.jpg","largeCard":"https://static01.nyt.com/images/2026/01/22/multimedia/22FD-HEALTHY-SHEET-PAN-ROUNDUP-topart-turmericchicken-cmgt/22FD-HEALTHY-SHEET-PAN-ROUNDUP-topart-turmericchicken-cmgt-master315.jpg"}},"type":"article","tracking_params":{"algo":"query_based_metadata_cooking_article_popularity","experiment_name":"ALGO_CK_RDP_to_Article_Recirc_0","fellback":"false","imp_id":"8462360557616548","pool":"cooking-article-recirc-ls","req_id":"4312013545805794","surface":"cooking-rdp-to-article-recirc","variant":"query_based_metadata_cooking_article_popularity","variant_name":"query_based_metadata_cooking_article_popularity"}},{"id":100000011239896,"name":"These Thanksgiving Desserts Are Guaranteed to Steal the Show","byline":"By Genevieve Ko","url":"https://cooking.nytimes.com/article/2026-thanksgiving-desserts-pie-cake-fl