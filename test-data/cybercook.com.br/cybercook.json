  "instructions": [
    {
      "name": null,
      "items": [
        {
          "value": "Primeiro corte o frango em cubinhos."
        },
        {
          "value": "Em uma panela média, coloque o óleo, o alho e a cebola e espere dourar."
        },
        {
          "value": "Depois coloque o frango e o sal e a pimenta a gosto, aqueça até o ponto de fritura."
        },
        {
          "value": "Mexa bem e tampe meia panela para que crie água, espere."
        },
        {
          "value": "Sumir a água e começar a fritura."
        },
        {
          "value": "Quando o frango já tiver dourado, acrescente o molho de tomate e o champignon."
        },
        {
          "value": "Depois coloque a lata de creme de leite e mexa até espalhar, com a mesma lata encha de água."
        },
        {
          "value": "Mexa mais uma vez até misturar e deixe levantar fervura."
        },
        {
          "value": "O strogonoff está pronto para ser servido."
        }
      ]
    }
